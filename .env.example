# Set the verified public HTTPS domain before deployment.
SITE_URL=https://cf.app
# Production builds are indexable. Set false on staging/preview deployments.
SITE_INDEXABLE=true
# Only the content value of the google-site-verification meta tag, if using HTML verification.
GOOGLE_SITE_VERIFICATION=
# HTTPS endpoint that durably accepts inquiries; never exposed to the browser.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=
# Enable after completing /privacidad with the actual responsible entity and data policy.
CONTACT_PRIVACY_READY=false
